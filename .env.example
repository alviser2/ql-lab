# =========================
# Frontend (Vite)
# =========================
# API base URL for browser requests.
# - If frontend and backend are behind the same domain/reverse-proxy,
#   keep this as /api.
# - If backend is on another origin, set full URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# =========================
# Backend (Express)
# =========================
# Server port
PORT=3001

# Runtime environment: development | production
NODE_ENV=development

# Required in production. Use a strong random secret.
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed browser origins for CORS.
# Example:
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:5173

# SQLite database path (file). Can be absolute or relative.
# In production, prefer external volume path, e.g. /data/giao_ban.db
DB_PATH=server/giao_ban.db

# Seed initial demo data at startup.
# - development: true/false
# - production: keep false (or omit)
SEED_ON_START=false
